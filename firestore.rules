rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isRoomHost(roomId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid;
    }
    
    function isApprovedParticipant(roomId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.status == "approved";
    }

    match /rooms/{roomId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isRoomHost(roomId) || 
        resource.data.hostUid == request.auth.uid ||
        request.resource.data.hostUid == request.auth.uid
      );
      allow delete: if isRoomHost(roomId);

      match /participants/{participantId} {
        allow create: if isAuthenticated() && 
          request.auth.uid == participantId;

        allow read: if isAuthenticated() && 
          (isRoomHost(roomId) || request.auth.uid == participantId || isApprovedParticipant(roomId));

        allow update: if isRoomHost(roomId) || (isAuthenticated() && request.auth.uid == participantId);
        allow delete: if isRoomHost(roomId) || (isAuthenticated() && request.auth.uid == participantId);
      }

      match /typing/{typingId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated();
      }

      match /messages/{messageId} {
        allow read: if isApprovedParticipant(roomId) || isRoomHost(roomId);
        // Allow approved participants/host to create messages.
        // senderUid can be the user's own UID, or 'system'/'ai_mentor' for system-generated messages.
        allow create: if (isApprovedParticipant(roomId) || isRoomHost(roomId)) &&
          (request.resource.data.senderUid == request.auth.uid ||
           request.resource.data.senderUid == 'system' ||
           request.resource.data.senderUid == 'ai_mentor');
        allow update, delete: if isRoomHost(roomId) || 
          (isAuthenticated() && resource.data.senderUid == request.auth.uid);
      }
    }
  }
}
