rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isRoomHost(roomId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid;
    }
    
    function isApprovedParticipant(roomId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.status == "approved";
    }

    // Study administrators: the primary bootstrap account, plus accounts it added (custom claim
    // role: 'admin', set by functions/src/roles.js)
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'bb900114@gmail.com' || request.auth.token.role == 'admin');
    }

    // Observers (custom claim set by functions/src/roles.js) and the administrator: read-only access
    // to every study room, board, event log, upload status and AI log
    function isObserver() {
      return isAdmin() || (isAuthenticated() && request.auth.token.role == 'observer');
    }

    // Human coding is independent of AI logs. Each observer owns their answers.
    match /codingRooms/{roomId}/items/{messageId}/ratings/{uid} {
      allow read: if isObserver() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isObserver() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/rooms/$(roomId)/messages/$(messageId))
        && request.resource.data.keys().hasOnly(['thinking', 'discussion', 'necessity', 'action', 'ambiguous', 'important', 'reason', 'status', 'revision', 'schemaVersion', 'updatedAt', 'source'])
        && request.resource.data.source.keys().hasOnly(['roomId', 'messageId', 'messageTimestamp', 'contextMessageIds', 'sampledAt', 'samplingMethod'])
        && request.resource.data.source.roomId == roomId
        && request.resource.data.source.messageId == messageId
        && request.resource.data.source.messageTimestamp is number
        && request.resource.data.source.sampledAt is number
        && request.resource.data.source.contextMessageIds is list
        && request.resource.data.source.contextMessageIds.size() > 0
        && request.resource.data.source.contextMessageIds[request.resource.data.source.contextMessageIds.size() - 1] == messageId
        && request.resource.data.source.samplingMethod in ['random-human-message-v1', 'researcher-selection']
        && (resource == null || resource.data.get('source', null) == null || request.resource.data.source == resource.data.source)
        && request.resource.data.schemaVersion == 2
        && request.resource.data.status in ['draft', 'submitted']
        && request.resource.data.thinking in ['', 'diverge', 'converge', 'iterate', 'reflect']
        && validCodingChoices(request.resource.data.discussion, ['effective', 'creativeDetour', 'misunderstanding', 'stalled', 'offTopic'], false)
        && request.resource.data.necessity in ['', 'unnecessary', 'optional', 'worthwhile', 'urgent']
        && validCodingChoices(request.resource.data.action, ['silent', 'clarify', 'connect', 'refocus', 'compare'], false)
        && request.resource.data.ambiguous is bool
        && request.resource.data.important is bool
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 1000
        && request.resource.data.updatedAt is number
        && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && (request.resource.data.status == 'draft' || (
          request.resource.data.thinking != '' && request.resource.data.discussion.size() > 0
          && request.resource.data.necessity != '' && request.resource.data.action.size() > 0
          && (!(request.resource.data.ambiguous || request.resource.data.important)
            || request.resource.data.reason.matches('.*[^\\s].*'))));
    }

    function validCodingChoices(value, options, single) {
      return value is list && value.toSet().hasOnly(options)
        && value.size() == value.toSet().size()
        && (!single || value.size() <= 1)
        && (request.resource.data.status == 'draft' || value.size() > 0);
    }
    function validCodingScore(value) {
      return value is int && value <= 5
        && value >= (request.resource.data.status == 'draft' ? 0 : 1);
    }
    match /codingRooms/{roomId}/items/{messageId} {
      allow read: if isObserver();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['replyId', 'selectedBy', 'selectedAt'])
        && request.resource.data.selectedBy == request.auth.uid
        && request.resource.data.selectedAt is number
        && get(/databases/$(database)/documents/rooms/$(roomId)/messages/$(request.resource.data.replyId)).data.senderUid in ['ai_mentor', 'ai_mentor_3d']
        && get(/databases/$(database)/documents/rooms/$(roomId)/messages/$(request.resource.data.replyId)).data.timestamp
          >= get(/databases/$(database)/documents/rooms/$(roomId)/messages/$(messageId)).data.timestamp
        && request.resource.data.replyId != messageId;
      match /detailedRatings/{uid} {
        allow read: if isObserver() && (request.auth.uid == uid || isAdmin());
        allow create, update: if isObserver() && request.auth.uid == uid
          && get(/databases/$(database)/documents/codingRooms/$(roomId)/items/$(messageId)/ratings/$(uid)).data.status == 'submitted'
          && request.resource.data.replyId == get(/databases/$(database)/documents/codingRooms/$(roomId)/items/$(messageId)).data.replyId
          && request.resource.data.keys().hasOnly(['labels', 'scores', 'replyId', 'ambiguous', 'important', 'reason', 'status', 'revision', 'schemaVersion', 'updatedAt'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.status in ['draft', 'submitted']
          && request.resource.data.revision is int
          && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
          && request.resource.data.updatedAt is number
          && request.resource.data.ambiguous is bool && request.resource.data.important is bool
          && request.resource.data.reason is string && request.resource.data.reason.size() <= 1000
          && (request.resource.data.status == 'draft' || !(request.resource.data.ambiguous || request.resource.data.important)
            || request.resource.data.reason.matches('.*[^\\s].*'))
          && request.resource.data.labels.keys().hasOnly(['design_stage', 'thinking_mode', 'design_behavior', 'collaboration_behavior', 'collaboration_situation', 'intervention_level', 'mentor_strategy'])
          && validCodingChoices(request.resource.data.labels.design_stage, ['discover', 'define', 'develop', 'deliver', 'uncertain'], true)
          && validCodingChoices(request.resource.data.labels.thinking_mode, ['divergent', 'convergent', 'iterative', 'reflective', 'uncertain'], true)
          && validCodingChoices(request.resource.data.labels.design_behavior, ['NEED', 'REFRAME', 'IDEATE', 'ELABORATE', 'CRITIQUE', 'EXTERNALIZE', 'DECIDE', 'REFLECT', 'SOCIAL'], false)
          && validCodingChoices(request.resource.data.labels.collaboration_behavior, ['PROPOSE', 'UPTAKE', 'BUILD_ON', 'CHALLENGE', 'CLARIFY', 'INTEGRATE', 'RATIFY', 'PROCESS_NEGOTIATION'], false)
          && validCodingChoices(request.resource.data.labels.collaboration_situation, ['effective', 'true_off_topic', 'productive_detour', 'premature_convergence_risk', 'unresolved_misunderstanding', 'constructive_disagreement', 'true_stall', 'transition_readiness', 'explicit_pause'], false)
          && (!('effective' in request.resource.data.labels.collaboration_situation) || request.resource.data.labels.collaboration_situation.size() == 1)
          && validCodingChoices(request.resource.data.labels.intervention_level, ['0_no_intervention', '1_optional', '2_warranted', '3_urgent'], true)
          && validCodingChoices(request.resource.data.labels.mentor_strategy, ['SILENCE', 'REFOCUS', 'ASK_OPEN_QUESTION', 'CLARIFY', 'CONNECT_IDEAS', 'OFFER_METHOD', 'SUMMARIZE', 'INVITE_COMPARISON', 'SUGGEST_REPRESENTATION', 'ASK_PERMISSION', 'RESPECT_PAUSE', 'FACT_CHECK'], false)
          && request.resource.data.scores.keys().hasOnly(['stageFit', 'creativeAutonomy', 'contextualRelevance', 'interactionalSupport', 'clarity', 'nonRedundancy', 'grounding'])
          && validCodingScore(request.resource.data.scores.stageFit)
          && validCodingScore(request.resource.data.scores.creativeAutonomy)
          && validCodingScore(request.resource.data.scores.contextualRelevance)
          && validCodingScore(request.resource.data.scores.interactionalSupport)
          && validCodingScore(request.resource.data.scores.clarity)
          && validCodingScore(request.resource.data.scores.nonRedundancy)
          && validCodingScore(request.resource.data.scores.grounding);
      }
    }

    // System-wide AI settings (models, 3D engine). API keys are NOT stored here; they live in Cloud Functions secrets.
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Experiment condition profiles (AI name, persona, mode, timing, modules) and their version history
    match /aiProfiles/{profileId} {
      allow read: if isObserver();
      allow write: if isAdmin();
      match /versions/{version} {
        allow read: if isObserver();
        allow write: if isAdmin();
      }
    }

    // Per-room frozen profile, trigger state and long-term AI memory: written only by Cloud Functions
    match /roomAi/{roomId} {
      allow read: if isObserver();
      allow write: if false;
    }

    // Research log of every AI decision: written only by Cloud Functions
    match /aiLogs/{logId} {
      allow read: if isObserver();
      allow write: if false;
    }

    // Google Drive export status (functions/src/drive.js); the OAuth token itself is in privateConfig,
    // which has no rule and is therefore unreachable from browsers
    match /driveStatus/{docId} {
      allow read: if isObserver();
      allow write: if false;
    }
    match /roomExports/{roomId} {
      allow read: if isObserver();
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }


    match /rooms/{roomId} {
      // Fields every approved participant may change: chat activity, stopping the AI, whiteboard snapshots for the AI
      function participantFields() {
        return ['lastActive', 'lastMessage', 'whiteboardMemories', 'aiAbortAt', 'aiActiveTask'];
      }
      // ...and the host of a room from before the experiment flow (no session) may close / reopen it.
      // Names, session, ai, progress, hostUid and observerUids are written only by Cloud Functions.
      function hostFields() {
        return participantFields().concat(['roomStatus']);
      }
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Created only by the createStudyRoom function (PIN registry roomPins/*, server-only)
      allow create: if false;
      // A missing doc is readable (stale room index entries are cleaned up); join pages use peekStudyRoom
      allow read: if resource == null || isObserver() || resource.data.hostUid == request.auth.uid ||
        request.auth.uid in resource.data.get('participantUids', []);
      allow update: if isAuthenticated() && (
        (resource.data.hostUid == request.auth.uid && changedKeys().hasOnly(hostFields())) ||
        (isApprovedParticipant(roomId) && changedKeys().hasOnly(participantFields())) ||
        // Leaving a room for good: remove only yourself from participantUids
        (changedKeys().hasOnly(['participantUids']) &&
          request.resource.data.participantUids.toSet() == resource.data.get('participantUids', []).toSet().difference([request.auth.uid].toSet()))
      );
      // Rooms are never deleted from browsers (Admin marks them deleted through adminDeleteRoom)
      allow delete: if false;

      function myStatus() {
        return get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.status;
      }
      function isMember() {
        return isApprovedParticipant(roomId) || isRoomHost(roomId);
      }

      match /participants/{participantId} {
        // Every member record is written by Cloud Functions (createStudyRoom, joinStudyRoom)
        allow create: if false;

        allow read: if isAuthenticated() &&
          (isRoomHost(roomId) || request.auth.uid == participantId || isApprovedParticipant(roomId) || isObserver());

        // Own record: presence and the open board only. Status, consent, name and avatar change through
        // Cloud Functions (joinStudyRoom, updateRoomProfile); the host may mute or remove members.
        allow update: if isRoomHost(roomId) || (isAuthenticated() && request.auth.uid == participantId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['consent', 'displayName', 'avatar', 'status']));
        allow delete: if isRoomHost(roomId) || (isAuthenticated() && request.auth.uid == participantId);
      }

      // Typing indicators: own document, or clearing the AI's after aborting it
      match /typing/{typingId} {
        allow read: if isMember() || isObserver();
        allow create, update, delete: if isMember() && (typingId == request.auth.uid || typingId == 'ai_mentor');
      }

      // Whiteboard v2: objects and presence of the board whose chat card is messages/{boardId}.
      // Public boards are open to every member; private boards only to their creator. Observers read all.
      function canUseBoard(boardId) {
        let card = get(/databases/$(database)/documents/rooms/$(roomId)/messages/$(boardId)).data;
        return isMember() &&
          (card.metadata.isPrivate == false || card.metadata.creatorUid == request.auth.uid);
      }

      match /boards/{boardId}/{document=**} {
        allow read: if isObserver() || canUseBoard(boardId);
        allow write: if canUseBoard(boardId);
      }

      // Research event log: browsers append their own events (observers included); observers read
      match /events/{eventId} {
        allow create: if (isMember() || (isObserver() && myStatus() == 'observer')) &&
          request.resource.data.uid == request.auth.uid && request.resource.data.source == 'client';
        allow read: if isObserver();
      }

      match /messages/{messageId} {
        allow read: if isMember() || isObserver();
        // Participants post only as themselves; the researcher (host) is a read-only observer. AI and
        // system messages (notices, profile/room changes, time-up…) are written by Cloud Functions only.
        allow create: if isApprovedParticipant(roomId) && !isRoomHost(roomId) &&
          request.resource.data.senderUid == request.auth.uid;
        // Sender and type never change (no re-attributing a message to someone else, the AI or the system).
        // Other members may react/vote, and refresh the thumbnail of a shared board they edit.
        allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderUid', 'type']) && (
          isRoomHost(roomId) ||
          (isAuthenticated() && resource.data.senderUid == request.auth.uid) ||
          (isApprovedParticipant(roomId) && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pollVotes', 'actionOptions', 'suggestion', 'collage']) ||
            (resource.data.type == 'whiteboard_state' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fileData', 'metadata']) &&
              request.resource.data.get('fileData', {}).diff(resource.data.get('fileData', {})).affectedKeys().hasOnly(['url']) &&
              request.resource.data.get('metadata', {}).diff(resource.data.get('metadata', {})).affectedKeys().hasOnly(['updatedAt', 'boardV']))
          )));
        allow delete: if isRoomHost(roomId) ||
          (isAuthenticated() && resource.data.senderUid == request.auth.uid);
      }
    }
  }
}
