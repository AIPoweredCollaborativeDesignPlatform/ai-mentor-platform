# Optional. The frontend has the ai-mentor-web Firebase config built in (frontend/src/firebase/config.ts);
# set these in frontend/.env only to point the app at another Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI keys are NOT set here: they are Cloud Functions secrets
# (firebase functions:secrets:set ANTHROPIC_API_KEY | FAL_KEY | MESHY_API_KEY | TRIPO_API_KEY)
# and can be overridden and tested in /#/admin > System settings.
