rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isRoomHost(roomId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid;
    }
    
    function isApprovedParticipant(roomId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.status == "approved";
    }

    // Study administrators: the primary bootstrap account, plus accounts it added (custom claim
    // role: 'admin', set by functions/src/roles.js)
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'bb900114@gmail.com' || request.auth.token.role == 'admin');
    }

    // Observers (custom claim set by functions/src/roles.js) and the administrator: read-only access
    // to every study room, board, event log, upload status and AI log
    function isObserver() {
      return isAdmin() || (isAuthenticated() && request.auth.token.role == 'observer');
    }

    // System-wide AI settings (models, 3D engine). API keys are NOT stored here; they live in Cloud Functions secrets.
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Experiment condition profiles (AI name, persona, mode, timing, modules) and their version history
    match /aiProfiles/{profileId} {
      allow read: if isObserver();
      allow write: if isAdmin();
      match /versions/{version} {
        allow read: if isObserver();
        allow write: if isAdmin();
      }
    }

    // Per-room frozen profile, trigger state and long-term AI memory: written only by Cloud Functions
    match /roomAi/{roomId} {
      allow read: if isObserver();
      allow write: if false;
    }

    // Research log of every AI decision: written only by Cloud Functions
    match /aiLogs/{logId} {
      allow read: if isObserver();
      allow write: if false;
    }

    // Google Drive export status (functions/src/drive.js); the OAuth token itself is in privateConfig,
    // which has no rule and is therefore unreachable from browsers
    match /driveStatus/{docId} {
      allow read: if isObserver();
      allow write: if false;
    }
    match /roomExports/{roomId} {
      allow read: if isObserver();
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }


    match /rooms/{roomId} {
      // Fields every approved participant may change: chat activity, stopping the AI, whiteboard snapshots for the AI
      function participantFields() {
        return ['lastActive', 'lastMessage', 'whiteboardMemories', 'aiAbortAt', 'aiActiveTask'];
      }
      // ...and the host of a room from before the experiment flow (no session) may close / reopen it.
      // Names, session, ai, progress, hostUid and observerUids are written only by Cloud Functions.
      function hostFields() {
        return participantFields().concat(['roomStatus']);
      }
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Created only by the createStudyRoom function (PIN registry roomPins/*, server-only)
      allow create: if false;
      // A missing doc is readable (stale room index entries are cleaned up); join pages use peekStudyRoom
      allow read: if resource == null || isObserver() || resource.data.hostUid == request.auth.uid ||
        request.auth.uid in resource.data.get('participantUids', []);
      allow update: if isAuthenticated() && (
        (resource.data.hostUid == request.auth.uid && changedKeys().hasOnly(hostFields())) ||
        (isApprovedParticipant(roomId) && changedKeys().hasOnly(participantFields())) ||
        // Leaving a room for good: remove only yourself from participantUids
        (changedKeys().hasOnly(['participantUids']) &&
          request.resource.data.participantUids.toSet() == resource.data.get('participantUids', []).toSet().difference([request.auth.uid].toSet()))
      );
      // Rooms are never deleted from browsers (Admin marks them deleted through adminDeleteRoom)
      allow delete: if false;

      function myStatus() {
        return get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.status;
      }
      function isMember() {
        return isApprovedParticipant(roomId) || isRoomHost(roomId);
      }

      match /participants/{participantId} {
        // Every member record is written by Cloud Functions (createStudyRoom, joinStudyRoom)
        allow create: if false;

        allow read: if isAuthenticated() &&
          (isRoomHost(roomId) || request.auth.uid == participantId || isApprovedParticipant(roomId) || isObserver());

        // Own record: presence and the open board only. Status, consent, name and avatar change through
        // Cloud Functions (joinStudyRoom, updateRoomProfile); the host may mute or remove members.
        allow update: if isRoomHost(roomId) || (isAuthenticated() && request.auth.uid == participantId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['consent', 'displayName', 'avatar', 'status']));
        allow delete: if isRoomHost(roomId) || (isAuthenticated() && request.auth.uid == participantId);
      }

      // Typing indicators: own document, or clearing the AI's after aborting it
      match /typing/{typingId} {
        allow read: if isMember() || isObserver();
        allow create, update, delete: if isMember() && (typingId == request.auth.uid || typingId == 'ai_mentor');
      }

      // Whiteboard v2: objects and presence of the board whose chat card is messages/{boardId}.
      // Public boards are open to every member; private boards only to their creator. Observers read all.
      function canUseBoard(boardId) {
        let card = get(/databases/$(database)/documents/rooms/$(roomId)/messages/$(boardId)).data;
        return isMember() &&
          (card.metadata.isPrivate == false || card.metadata.creatorUid == request.auth.uid);
      }

      match /boards/{boardId}/{document=**} {
        allow read: if isObserver() || canUseBoard(boardId);
        allow write: if canUseBoard(boardId);
      }

      // Research event log: browsers append their own events (observers included); observers read
      match /events/{eventId} {
        allow create: if (isMember() || (isObserver() && myStatus() == 'observer')) &&
          request.resource.data.uid == request.auth.uid && request.resource.data.source == 'client';
        allow read: if isObserver();
      }

      match /messages/{messageId} {
        allow read: if isMember() || isObserver();
        // Participants post only as themselves; the researcher (host) is a read-only observer. AI and
        // system messages (notices, profile/room changes, time-up…) are written by Cloud Functions only.
        allow create: if isApprovedParticipant(roomId) && !isRoomHost(roomId) &&
          request.resource.data.senderUid == request.auth.uid;
        // Sender and type never change (no re-attributing a message to someone else, the AI or the system).
        // Other members may react/vote, and refresh the thumbnail of a shared board they edit.
        allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderUid', 'type']) && (
          isRoomHost(roomId) ||
          (isAuthenticated() && resource.data.senderUid == request.auth.uid) ||
          (isApprovedParticipant(roomId) && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pollVotes', 'actionOptions', 'suggestion', 'collage']) ||
            (resource.data.type == 'whiteboard_state' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fileData', 'metadata']) &&
              request.resource.data.get('fileData', {}).diff(resource.data.get('fileData', {})).affectedKeys().hasOnly(['url']) &&
              request.resource.data.get('metadata', {}).diff(resource.data.get('metadata', {})).affectedKeys().hasOnly(['updatedAt', 'boardV']))
          )));
        allow delete: if isRoomHost(roomId) ||
          (isAuthenticated() && resource.data.senderUid == request.auth.uid);
      }
    }
  }
}
