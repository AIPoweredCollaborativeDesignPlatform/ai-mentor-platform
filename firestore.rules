rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isRoomHost(roomId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid;
    }
    
    function isApprovedParticipant(roomId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.status == "approved";
    }

    // Study administrator (bootstrap account; observers are added in a later phase)
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'bb900114@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // System-wide AI settings (models, 3D engine). API keys are NOT stored here; they live in Cloud Functions secrets.
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Experiment condition profiles (AI name, persona, mode, timing, modules) and their version history
    match /aiProfiles/{profileId} {
      allow read, write: if isAdmin();
      match /versions/{version} {
        allow read, write: if isAdmin();
      }
    }

    // Per-room frozen profile, trigger state and long-term AI memory: written only by Cloud Functions
    match /roomAi/{roomId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Research log of every AI decision: written only by Cloud Functions
    match /aiLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    match /rooms/{roomId} {
      allow create: if isAuthenticated() && !('session' in request.resource.data);
      allow read: if isAuthenticated();
      // The experiment flow (session) is written only by Cloud Functions (functions/src/session.js)
      allow update: if isAuthenticated() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['session']);
      allow delete: if isRoomHost(roomId);

      match /participants/{participantId} {
        // Participants are approved by the joinStudyRoom function; a browser may only create the
        // host's own record or a pending request (legacy site flow)
        allow create: if isAuthenticated() && request.auth.uid == participantId &&
          (isRoomHost(roomId) || request.resource.data.status == 'pending');

        allow read: if isAuthenticated() && 
          (isRoomHost(roomId) || request.auth.uid == participantId || isApprovedParticipant(roomId));

        // Own record: presence, name, avatar; never self-approval or the consent record
        allow update: if isRoomHost(roomId) || (isAuthenticated() && request.auth.uid == participantId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['consent']) &&
          (request.resource.data.status == resource.data.status || request.resource.data.status in ['pending', 'cancelled', 'left']));
        allow delete: if isRoomHost(roomId) || (isAuthenticated() && request.auth.uid == participantId);
      }

      match /typing/{typingId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated();
      }

      match /cursors/{cursorId} {
        allow read, write: if isAuthenticated();
      }

      // Whiteboard v2: objects and presence of the board whose chat card is messages/{boardId}.
      // Public boards are open to every member; private boards only to their creator.
      function canUseBoard(boardId) {
        let card = get(/databases/$(database)/documents/rooms/$(roomId)/messages/$(boardId)).data;
        return (isApprovedParticipant(roomId) || isRoomHost(roomId)) &&
          (card.metadata.isPrivate == false || card.metadata.creatorUid == request.auth.uid);
      }

      match /boards/{boardId}/{document=**} {
        allow read: if canUseBoard(boardId) || isAdmin();
        allow write: if canUseBoard(boardId);
      }

      // Research event log: browsers append their own events; only the study administrator reads
      match /events/{eventId} {
        allow create: if (isApprovedParticipant(roomId) || isRoomHost(roomId)) &&
          request.resource.data.uid == request.auth.uid && request.resource.data.source == 'client';
        allow read: if isAdmin();
      }

      match /messages/{messageId} {
        allow read: if isApprovedParticipant(roomId) || isRoomHost(roomId);
        // Participants post as themselves (or 'system'/'ai_mentor' notices); the researcher (host)
        // is a read-only observer and may only post system notices.
        allow create: if (isRoomHost(roomId) && request.resource.data.senderUid == 'system') ||
          (isApprovedParticipant(roomId) && !isRoomHost(roomId) &&
          (request.resource.data.senderUid == request.auth.uid ||
           request.resource.data.senderUid == 'system' ||
           request.resource.data.senderUid == 'ai_mentor'));
        allow update: if isRoomHost(roomId) || 
          (isAuthenticated() && resource.data.senderUid == request.auth.uid) ||
          (isApprovedParticipant(roomId) && (
            resource.data.type == 'whiteboard_state' ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pollVotes', 'actionOptions'])
          ));
        allow delete: if isRoomHost(roomId) || 
          (isAuthenticated() && resource.data.senderUid == request.auth.uid);
      }
    }
  }
}
