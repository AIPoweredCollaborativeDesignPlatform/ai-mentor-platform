rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 3D model files: public read (for model-viewer / CORS), authenticated write only
    match /models/{modelFile} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // All other paths: authenticated users only
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
