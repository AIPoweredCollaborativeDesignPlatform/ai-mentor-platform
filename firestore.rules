rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isRoomHost(roomId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid;
    }
    
    function isApprovedParticipant(roomId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.status == "approved";
    }

    // Study administrator (bootstrap account; observers are added in a later phase)
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'bb900114@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // System-wide AI settings (models, 3D engine). API keys are NOT stored here; they live in Cloud Functions secrets.
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Experiment condition profiles (AI name, persona, mode, timing, modules) and their version history
    match /aiProfiles/{profileId} {
      allow read, write: if isAdmin();
      match /versions/{version} {
        allow read, write: if isAdmin();
      }
    }

    // Per-room frozen profile, trigger state and long-term AI memory: written only by Cloud Functions
    match /roomAi/{roomId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Research log of every AI decision: written only by Cloud Functions
    match /aiLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    match /rooms/{roomId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isRoomHost(roomId);

      match /participants/{participantId} {
        allow create: if isAuthenticated() && 
          request.auth.uid == participantId;

        allow read: if isAuthenticated() && 
          (isRoomHost(roomId) || request.auth.uid == participantId || isApprovedParticipant(roomId));

        allow update: if isRoomHost(roomId) || (isAuthenticated() && request.auth.uid == participantId);
        allow delete: if isRoomHost(roomId) || (isAuthenticated() && request.auth.uid == participantId);
      }

      match /typing/{typingId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated();
      }

      match /cursors/{cursorId} {
        allow read, write: if isAuthenticated();
      }

      match /messages/{messageId} {
        allow read: if isApprovedParticipant(roomId) || isRoomHost(roomId);
        // Allow approved participants/host to create messages.
        // senderUid can be the user's own UID, or 'system'/'ai_mentor' for system-generated messages.
        allow create: if (isApprovedParticipant(roomId) || isRoomHost(roomId)) &&
          (request.resource.data.senderUid == request.auth.uid ||
           request.resource.data.senderUid == 'system' ||
           request.resource.data.senderUid == 'ai_mentor');
        allow update: if isRoomHost(roomId) || 
          (isAuthenticated() && resource.data.senderUid == request.auth.uid) ||
          (isApprovedParticipant(roomId) && (
            resource.data.type == 'whiteboard_state' ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pollVotes', 'actionOptions'])
          ));
        allow delete: if isRoomHost(roomId) || 
          (isAuthenticated() && resource.data.senderUid == request.auth.uid);
      }
    }
  }
}
